{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/health"
    },
    {
      "source": "/auth",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/auth/:path*"
    },
    {
      "source": "/opportunities",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/opportunities"
    },
    {
      "source": "/opportunities/:path*",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/opportunities/:path*"
    },
    {
      "source": "/applications",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/applications"
    },
    {
      "source": "/applications/:path*",
      "destination": "https://internship-lifecycle-api-62997789.onrender.com/applications/:path*"
