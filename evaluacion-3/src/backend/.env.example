# Copy to .env (never commit real secrets).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
JWT_SECRET=change-me
JWT_TTL_MINUTES=15
APP_DB_ROLE=app_user
# Demo-preview assumption only; confirm institutional authority before deployment.
OPPORTUNITY_REVIEWER_ROLES=EXPERIENTIAL_COORDINATOR
OPPORTUNITY_PUBLISHER_ROLES=EXPERIENTIAL_COORDINATOR
# Optional; reassignment stays disabled unless a deployment explicitly configures it.
PLACEMENT_FACULTY_ASSIGNER_ROLES=
